# =========================================================
# Document AI Telegram Bot - environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# =========================================================

# --- Telegram ---
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot.
# Example: ALLOWED_TELEGRAM_IDS=111111111,222222222
ALLOWED_TELEGRAM_IDS=

# Comma-separated Telegram user IDs that get the ADMIN role.
# Must be a subset of ALLOWED_TELEGRAM_IDS.
ADMIN_TELEGRAM_IDS=

# Webhook mode (production). Leave WEBHOOK_URL empty to use long polling (dev).
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/webhook
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# --- Google Gemini ---
GEMINI_API_KEY=
# Model id is fully configurable - do not hard-code a specific model in code.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=3
# Explicit output-length ceiling - a dense/bilingual scanned page can
# genuinely need a large JSON response; too low a value causes
# structured-output generation to truncate silently (see gemini_service.py).
GEMINI_MAX_OUTPUT_TOKENS=65536

# --- Database ---
DATABASE_URL=postgresql+asyncpg://doc_ai:doc_ai@localhost:5432/doc_ai_bot

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- File handling ---
MAX_FILE_SIZE_MB=50
FILE_RETENTION_HOURS=24
MAX_PDF_PAGES=60
# Maximum number of files collected into one batch (📦 Batch process).
MAX_BATCH_SIZE=10
STORAGE_ROOT=storage

# --- Logging ---
LOG_LEVEL=INFO

# --- FastAPI health endpoint ---
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8081
